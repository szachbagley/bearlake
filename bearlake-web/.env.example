# Bear Lake admin web app — environment configuration
# Copy to .env.local for local development. .env.local is gitignored and must
# never be committed. Every VITE_* variable here is inlined into the public
# JavaScript bundle at build time (plan W36) — never put a secret in one.

# Base URL of the API, including /api/v1.
# In development, leave this as the proxy path below; vite.config.ts forwards
# /api requests to VITE_DEV_API_PROXY, so the browser never talks cross-origin.
VITE_API_BASE_URL=/api/v1

# Dev-only: where the Vite dev-server proxy forwards /api requests.
VITE_DEV_API_PROXY=http://localhost:3000

# Production: set in the Vercel project's environment settings (W34), not here.
# The value points at the API, which is deployed separately on Railway:
# VITE_API_BASE_URL=https://bearlake-server-production.up.railway.app/api/v1
